# ------------------------------------------------------------------------------
# 1. Environment and Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.local
*.env.*.local
!.env.example
!.env.*.example
!backend/.env.example
!frontend/.env.example

# Certificates and private keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Dependencies and Build Outputs
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js

# Next.js & Frontend builds
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/
coverage/
*/coverage/

# TypeScript build cache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 3. User Data & Uploads (PII)
# ------------------------------------------------------------------------------
uploads/
*/uploads/
backend/uploads/
!backend/uploads/.gitkeep

# ------------------------------------------------------------------------------
# 4. Local Development Artifacts & Archives
# ------------------------------------------------------------------------------
backup_checkpoint/
screenshots/
optimized_screenshots/
scratch_splits/
scratch_test/
test_image_split.py
frontend/app.zip
*.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Python runtime artifacts
__pycache__/
*.py[cod]
*$py.class

# ------------------------------------------------------------------------------
# 5. Documentation & Testing Artifacts
# ------------------------------------------------------------------------------
# Binary documents with embedded UI screenshots containing user/test data
*.docx

# Postman local workspace metadata (preserves shareable postman/ collections)
.postman/
